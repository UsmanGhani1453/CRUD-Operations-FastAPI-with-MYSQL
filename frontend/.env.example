# Copy to .env.local for local development, or set as an environment
# variable in your hosting provider (Vercel/Netlify/etc) for production.
#
# Must point at your deployed FastAPI backend, including scheme, no
# trailing slash.
VITE_API_URL=http://127.0.0.1:8000

# Stripe PUBLISHABLE key (safe to expose in the browser - starts with
# pk_test_ or pk_live_). Get it from https://dashboard.stripe.com/test/apikeys
# This must be the SAME Stripe account as the backend's STRIPE_SECRET_KEY,
# both in test mode or both in live mode.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
