# Copy this file to .env and fill in real values.
# .env is already gitignored - never commit real secrets.

ENVIRONMENT=development

# --- Database ---
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/my_database

# --- Auth ---
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-64-char-hex-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24

# --- Email (SMTP) ---
# For Gmail: use an App Password, not your account password.
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SENDER_EMAIL=your-app@example.com
SENDER_PASSWORD=your-app-password
APP_BASE_URL=http://127.0.0.1:8000

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# --- Currency ---
CURRENCY=usd

# --- Seed admin (used by seed.py only) ---
SEED_ADMIN_EMAIL=admin@haak.com
SEED_ADMIN_PASSWORD=change-me
